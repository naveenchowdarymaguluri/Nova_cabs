{
  // VS Code Flutter launch configuration for Nova Cabs
  // Secrets are injected at build time via --dart-define-from-file
  // The .env file is read by the flutter tool ONLY — it is never bundled into the app.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nova Cabs (dev)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=.env"
      ]
    },
    {
      "name": "Nova Cabs (release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "toolArgs": [
        "--dart-define-from-file=.env",
        "--obfuscate",
        "--split-debug-info=build/debug-info"
      ]
    },
    {
      "name": "Nova Cabs Admin (dev)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_desktop_admin.dart",
      "toolArgs": [
        "--dart-define-from-file=.env"
      ]
    }
  ]
}
