# =============================================================
# Nova Cabs - Environment Variables Template
# =============================================================
# INSTRUCTIONS:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to git (it is already in .gitignore)
#   4. Share real values with teammates via a secure channel
#      (e.g., 1Password, Bitwarden, or your CI/CD secrets vault)
# =============================================================

# MSG91 Configuration (SMS OTP)
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY_HERE
MSG91_TEMPLATE_ID=YOUR_MSG91_TEMPLATE_ID_HERE

# Google Maps API Key
# Restrict this key in Google Cloud Console:
#   APIs & Services → Credentials → API key → Application restrictions
#   Set "Android apps" + your package name + SHA-1, or "iOS apps" + bundle ID
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
